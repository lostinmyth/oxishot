import { Toolbar } from "toolbar/toolbar.slint";

import { Action, Actions } from "actions.slint";
import { Canvas, SelectionMode } from "canvas.slint";
import { StylePanel, ColorPopover, FontPopover, WeightPopover } from "style_panel.slint";
import { Styling, StyleField } from "styling.slint";

export { Actions, Action } from "./actions.slint";
export { Canvas, SelectionBox, Vec2, SelectionMode } from "canvas.slint";
export { Styling, StyleField, ParsedColor } from "styling.slint";

export component MainWindow inherits Window {
    in property <image> img;
    forward-focus: keys;

    // text tool: where the pending TextInput sits and whether it's open
    property <bool> typing;
    property <length> text-x;
    property <length> text-y;

    // switching tools (e.g. via the toolbar) commits pending text
    property <Action> tool: Actions.current-tool;
    changed tool => {
        root.commit-text();
        // the eyedropper keeps the selection: it recolors it
        if root.tool != Action.select && root.tool != Action.eyedropper { Actions.dispatch(Action.deselect); }
    }

    function commit-text() {
        if root.typing && text-editor.text != "" {
            Canvas.commit-text(root.text-x / 1phx, root.text-y / 1phx, text-editor.text);
        }
        root.cancel-text();
    }

    // the color popover is open, editing `picking-field`
    property <bool> picking;
    property <StyleField> picking-field;

    function close-picker() {
        if !root.picking { return; }
        root.picking = false;
        root.sampling = false;
        Styling.commit();
        keys.focus();
    }

    // the color popover's eyedropper is on: canvas presses pick its color
    property <bool> sampling;

    // the color popover sits under the style panel until dragged; then it
    // stays where it was put (also between openings), inside the window
    property <bool> popover-moved;
    property <length> popover-x;
    property <length> popover-y;

    function drag-popover(dx: length, dy: length) {
        root.popover-x = clamp(popover.x + dx, 0, root.width - popover.width);
        root.popover-y = clamp(popover.y + dy, 0, root.height - popover.height);
        root.popover-moved = true;
    }

    // eyedropper tool: the color under (x, y) becomes the stroke color
    // (and of the selection, live; the release commits it as one undo step)
    function eyedrop(x: length, y: length) {
        let p = Canvas.sample(x / 1phx, y / 1phx);
        if p.ok {
            Styling.stroke = p.color;
            Styling.preview(StyleField.stroke);
        }
    }

    function cancel-text() {
        root.typing = false;
        text-editor.text = "";
        keys.focus();
    }

    // the smallest window the bars and an open color popover fit in (the
    // popover is ~435px with three swatch rows; that tall, it moves up over
    // the style panel and may cover the bottom bar's right end while open,
    // but is never cut off)
    property <length> floor-width: 320px;
    property <length> floor-height: 500px;
    out property <length> view-width: max(root.img.width * 1phx, root.floor-width);
    out property <length> view-height: max(root.img.height * 1phx, root.floor-height);
    width: root.view-width;
    height: root.view-height;
    background: #0e0e10;

    // the image and everything drawn on it, centered when the window is
    // bigger than the image
    stage := Rectangle {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: root.img.width * 1phx;
        height: root.img.height * 1phx;

        Image {
            width: root.img.width * 1phx;
            height: root.img.height * 1phx;
            source: root.img;
        }

        Image {
            width: root.img.width * 1phx;
            height: root.img.height * 1phx;
            source: Canvas.overlay;
        }

        Image {
            x: Canvas.drag-live ? 0 : Canvas.drag-offset.x * 1phx;
            y: Canvas.drag-live ? 0 : Canvas.drag-offset.y * 1phx;
            width: root.img.width * 1phx;
            height: root.img.height * 1phx;
            source: Canvas.drag-overlay;
            visible: Canvas.dragging;
            transform-rotation: Canvas.drag-live ? 0deg : Canvas.drag-angle;
            transform-origin: { x: Canvas.drag-pivot.x * 1phx, y: Canvas.drag-pivot.y * 1phx };
        }

        // the 3 here must match SEL_PAD in editor.rs (clicks inside this box hit the shape)
        // each box turns with its shape; the corner squares are scale handles,
        // and just outside them is where rotating starts
        for b in Canvas.selection: Rectangle {
            x: (b.x + (Canvas.dragging ? Canvas.drag-offset.x : 0) - 3) * 1phx;
            y: (b.y + (Canvas.dragging ? Canvas.drag-offset.y : 0) - 3) * 1phx;
            width: (b.width + 3 * 2) * 1phx;
            height: (b.height + 3 * 2) * 1phx;
            transform-rotation: b.angle * 1deg;
            transform-origin: { x: self.width / 2, y: self.height / 2 };
            border-width: 1px;
            border-color: #3b82f6;
            background: #3b82f60f;

            for c in [{ x: 0, y: 0 }, { x: 1, y: 0 }, { x: 1, y: 1 }, { x: 0, y: 1 }]: Rectangle {
                x: c.x * parent.width - 3.5px;
                y: c.y * parent.height - 3.5px;
                width: 7px;
                height: 7px;
                border-width: 1px;
                border-color: #3b82f6;
                background: white;
            }
        }

        if Canvas.has-marquee: Rectangle {
            x: Canvas.marquee.x * 1phx;
            y: Canvas.marquee.y * 1phx;
            width: Canvas.marquee.width * 1phx;
            height: Canvas.marquee.height * 1phx;
            border-width: 1px;
            border-color: #3b82f6cc;
            background: #3b82f61a;
        }

        Path {
            width: root.img.width * 1phx;
            height: root.img.height * 1phx;
            viewbox-width: root.img.width;
            viewbox-height: root.img.height;
            commands: Canvas.live-path;
            // a blur only shows its region until it's committed and rasterized
            stroke: Actions.current-tool == Action.blur ? #ffffffcc : Styling.stroke;
            stroke-width: Actions.current-tool == Action.blur ? 1px : Styling.radius * 2 * 1phx;
            fill: Actions.current-tool == Action.rectangle || Actions.current-tool == Action.circle ? Styling.fill
                : Actions.current-tool == Action.blur ? #ffffff26 : transparent;
            stroke-line-cap: round;
            // rectangles get square corners, matching Layer::box_outline
            stroke-line-join: Actions.current-tool == Action.rectangle || Actions.current-tool == Action.blur ? LineJoin.miter : LineJoin.round;
        }

        touch := TouchArea {
            enabled: Actions.current-tool == Action.select || Actions.current-tool == Action.brush || Actions.current-tool == Action.text || Actions.current-tool == Action.rectangle || Actions.current-tool == Action.circle || Actions.current-tool == Action.arrow || Actions.current-tool == Action.blur || Actions.current-tool == Action.eyedropper;
            // system resize cursors only come in fixed diagonals and theme sizes;
            // the icons below stand in for them, matching rotated boxes
            mouse-cursor: Canvas.scale-hover || Canvas.scaling || Canvas.rotate-hover || Canvas.rotating ? MouseCursor.none
                : Canvas.dragging ? MouseCursor.grabbing
                : Actions.current-tool == Action.text ? MouseCursor.text
                : Actions.current-tool == Action.select ? MouseCursor.default
                : MouseCursor.crosshair;
            pointer-event(e) => {
                if e.kind == PointerEventKind.move && Actions.current-tool == Action.select && !self.pressed {
                    Canvas.hover(self.mouse-x / 1phx, self.mouse-y / 1phx);
                }
                if e.button == PointerEventButton.left {
                    // leave an input (e.g. the width field) so shortcuts work again;
                    // the text tool moves focus to its own editor below
                    if e.kind == PointerEventKind.down { keys.focus(); }
                    if e.kind == PointerEventKind.down && Actions.current-tool == Action.text {
                        // clicking elsewhere commits the pending text (which
                        // switches to select); with nothing typed, it starts anew here
                        if root.typing && text-editor.text != "" {
                            root.commit-text();
                        } else {
                            root.cancel-text();
                            root.text-x = self.mouse-x;
                            root.text-y = self.mouse-y;
                            root.typing = true;
                            text-editor.focus();
                        }
                    } else if Actions.current-tool == Action.eyedropper {
                        if e.kind == PointerEventKind.down { root.eyedrop(self.mouse-x, self.mouse-y); }
                        if e.kind == PointerEventKind.up {
                            Styling.commit();
                            Actions.current-tool = Action.select;
                        }
                    } else if e.kind == PointerEventKind.down && Actions.current-tool == Action.select {
                        Canvas.select-begin(self.mouse-x / 1phx, self.mouse-y / 1phx,
                            e.modifiers.control ? SelectionMode.remove
                            : e.modifiers.shift ? SelectionMode.add
                            : SelectionMode.replace);
                    } else if e.kind == PointerEventKind.down {
                        Canvas.begin(self.mouse-x / 1phx, self.mouse-y / 1phx);
                    } else if e.kind == PointerEventKind.up {
                        Canvas.end(self.mouse-x / 1phx, self.mouse-y / 1phx);
                    }
                }
            }
            moved => {
                // dragging the eyedropper keeps sampling, so the panel shows what's under it
                if Actions.current-tool == Action.eyedropper {
                    root.eyedrop(self.mouse-x, self.mouse-y);
                    return;
                }
                Canvas.extend(self.mouse-x / 1phx, self.mouse-y / 1phx);
            }
        }

        if touch.has-hover && (Canvas.rotate-hover || Canvas.rotating): Image {
            x: touch.mouse-x - 10px;
            y: touch.mouse-y - 10px;
            width: 20px;
            height: 20px;
            source: @image-url("../assets/icons/rotate.svg");
            // the icon's arc hugs a top-left corner; turn it to the grabbed one
            // and keep turning it with the shapes while rotating
            transform-rotation: (Canvas.rotate-cursor + (Canvas.rotating ? Canvas.drag-angle / 1deg : 0)) * 1deg;
        }

        if touch.has-hover && (Canvas.scale-hover || Canvas.scaling): Image {
            x: touch.mouse-x - 10px;
            y: touch.mouse-y - 10px;
            width: 20px;
            height: 20px;
            source: @image-url("../assets/icons/scale.svg");
            // the icon runs along a top-left corner's bisector; turn it to the grabbed corner
            transform-rotation: Canvas.scale-cursor * 1deg;
        }

        // declared after the TouchArea so it sits on top and gets clicks for the caret
        // keys the TextInput doesn't use (Escape) bubble up to this scope
        FocusScope {
            x: root.text-x;
            y: root.text-y;
            width: text-editor.preferred-width;
            height: text-editor.preferred-height;
            visible: root.typing;
            key-pressed(event) => {
                if event.text == Key.Escape {
                    root.cancel-text();
                    return accept;
                }
                reject
            }

            text-editor := TextInput {
                enabled: root.typing;
                single-line: true;
                font-family: Styling.font-family;
                font-weight: Styling.font-weight;
                font-size: Styling.font-size * 1phx;
                color: Styling.stroke;
                accepted => { root.commit-text(); }
            }
        }
    }

    redo_undo_bar := Toolbar {
        y: 8px;
        x: 8px;
        selectable: false;
        view-width: parent.width;
        tools: [
            { icon: @image-url("../assets/icons/undo.svg"), name: "Undo", shortcut: "Ctrl+Z", action: Action.undo },
            { icon: @image-url("../assets/icons/redo.svg"), name: "Redo", shortcut: "Ctrl+Y", action: Action.redo },
        ];
    }

    controlbar := Toolbar {
        y: 0 + 8px;
        x: (parent.width - self.width - 8px);
        selectable: false;
        view-width: parent.width;
        tools: [
            { icon: @image-url("../assets/icons/settings.svg"), name: "Settings", shortcut: "", action: Action.settings },
            { icon: @image-url("../assets/icons/save.svg"), name: "Save", shortcut: "Ctrl+S", action: Action.save },
            { icon: @image-url("../assets/icons/copy.svg"), name: "Copy", shortcut: "Ctrl+C", action: Action.copy },
            { icon: @image-url("../assets/icons/cancel.svg"), name: "Exit", shortcut: "", action: Action.exit },
        ];
    }

    // under the save/copy bar: the style of new shapes, or of the selection
    style-panel := StylePanel {
        visible: self.relevant;
        width: controlbar.width;
        x: parent.width - self.width - 8px;
        y: controlbar.y + controlbar.height + 6px;
        picking: root.picking;
        picking-field: root.picking-field;
        open-picker(f) => {
            root.picking-field = f;
            root.picking = true;
            if f == StyleField.font-family {
                font-popover.open();
            } else if f == StyleField.font-weight {
                weight-popover.open();
            } else {
                popover.open-with(f == StyleField.fill ? Styling.fill : Styling.stroke);
            }
        }
        changed relevant => {
            if !self.relevant { root.close-picker(); }
        }
        input-accepted => { keys.focus(); }
    }

    paintbar := Toolbar {
        y: parent.height - self.height - 8px;
        x: (parent.width - self.width) / 2;
        tips-above: true;
        view-width: parent.width;
        tools: [
            {
                icon: @image-url("../assets/icons/mouse-pointer.svg"),
                name: "Select", shortcut: "V",
                action: Action.select
            },
            { icon: @image-url("../assets/icons/brush.svg"), name: "Brush", shortcut: "B", action: Action.brush },
            {
                icon: @image-url("../assets/icons/square-dashed-text.svg"),
                name: "Text", shortcut: "T",
                action: Action.text
            },
            {
                icon: @image-url("../assets/icons/square.svg"),
                name: "Rectangle", shortcut: "R",
                action: Action.rectangle
            },
            {
                icon: @image-url("../assets/icons/circle.svg"),
                name: "Circle", shortcut: "O",
                action: Action.circle
            },
            {
                icon: @image-url("../assets/icons/move-up-right.svg"),
                name: "Arrow", shortcut: "A",
                action: Action.arrow
            },
            { icon: @image-url("../assets/icons/blur.svg"), name: "Blur", shortcut: "U", action: Action.blur },
            {
                icon: @image-url("../assets/icons/eyedropper.svg"),
                name: "Eyedropper", shortcut: "I",
                action: Action.eyedropper
            },
        ];
        }

        // above everything else: a click outside the popover just closes it,
        // unless its eyedropper is on: then pressing (and dragging) picks the
        // color under the pointer, and releasing turns the eyedropper off
        if root.picking: TouchArea {
            mouse-cursor: root.sampling ? MouseCursor.crosshair : MouseCursor.default;
            function pick() {
                let p = Canvas.sample((self.mouse-x - stage.x) / 1phx, (self.mouse-y - stage.y) / 1phx);
                if p.ok { popover.take(p.color); }
            }
            pointer-event(e) => {
                if !root.sampling {
                    if e.kind == PointerEventKind.down { root.close-picker(); }
                } else if e.button == PointerEventButton.left {
                    if e.kind == PointerEventKind.down { self.pick(); }
                    if e.kind == PointerEventKind.up {
                        root.sampling = false;
                        Styling.commit();
                        popover.focus();
                    }
                }
            }
            moved => {
                if root.sampling { self.pick(); }
            }
        }

        popover := ColorPopover {
            // out of the way while its eyedropper picks; back on release
            visible: root.picking && !root.sampling && (root.picking-field == StyleField.stroke || root.picking-field == StyleField.fill);
            // undragged, it moves up as needed to stay 8px inside the window
            x: root.popover-moved ? root.popover-x : parent.width - self.width - 8px;
            y: root.popover-moved ? clamp(root.popover-y, 0, parent.height - self.height)
                : max(8px, min(style-panel.y + style-panel.height + 6px, parent.height - self.height - 8px));
            field: root.picking-field;
            dragged(dx, dy) => { root.drag-popover(dx, dy); }
            sampling: root.sampling;
            toggle-sampling => { root.sampling = !root.sampling; }
            close => { root.close-picker(); }
        }

        font-popover := FontPopover {
            visible: root.picking && root.picking-field == StyleField.font-family;
            x: parent.width - self.width - 8px;
            y: max(8px, min(style-panel.y + style-panel.height + 6px, parent.height - self.height - 8px));
            close => { root.close-picker(); }
        }

        weight-popover := WeightPopover {
            visible: root.picking && root.picking-field == StyleField.font-weight;
            x: parent.width - self.width - 8px;
            y: max(8px, min(style-panel.y + style-panel.height + 6px, parent.height - self.height - 8px));
            close => { root.close-picker(); }
        }

        // covers the whole window on top of everything; it's only for keys,
        // so it must not take presses (unfocused, it would eat the first one)
        keys := FocusScope {
            focus-on-click: false;
            key-pressed(event) => {
                if event.modifiers.control {
                    if event.text == "z" { Actions.dispatch(Action.undo); return accept; }
                    if event.text == "y" { Actions.dispatch(Action.redo); return accept; }
                    if event.text == "s" { Actions.dispatch(Action.save); return accept; }
                    if event.text == "c" { Actions.dispatch(Action.copy); return accept; }
                    if event.text == "a" {
                        Actions.current-tool = Action.select;
                        Actions.dispatch(Action.select-all);
                        return accept;
                    }
                    return reject;
                }
                if Actions.current-tool == Action.select {
                    if event.text == Key.Delete || event.text == Key.Backspace { Actions.dispatch(Action.delete); return accept; }
                    if event.text == Key.Escape { Actions.dispatch(Action.deselect); return accept; }
                }
                if event.text == "v" { Actions.current-tool = Action.select; return accept; }
                if event.text == "b" { Actions.current-tool = Action.brush; return accept; }
                if event.text == "t" { Actions.current-tool = Action.text; return accept; }
                if event.text == "r" { Actions.current-tool = Action.rectangle; return accept; }
                if event.text == "o" { Actions.current-tool = Action.circle; return accept; }
                if event.text == "a" { Actions.current-tool = Action.arrow; return accept; }
                if event.text == "u" { Actions.current-tool = Action.blur; return accept; }
                if event.text == "i" { Actions.current-tool = Action.eyedropper; return accept; }
                reject
            }
        }
    }

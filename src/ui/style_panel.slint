import { Action, Actions } from "actions.slint";
import { Styling, StyleField } from "styling.slint";
import { ColorPicker, ColorDot } from "color_picker.slint";
import { ListView } from "std-widgets.slint";

component ColorField inherits Rectangle {
    in property <color> value;
    in property <bool> active;
    callback clicked();

    height: 24px;
    border-radius: 5px;
    background: root.active ? #ffffff1f : ta.has-hover ? #ffffff14 : #ffffff0a;
    border-width: 1px;
    border-color: root.active ? #3b82f6 : #ffffff0f;
    animate background { duration: 90ms; }

    HorizontalLayout {
        padding-left: 5px;
        padding-right: 5px;
        spacing: 5px;

        ColorDot {
            y: (parent.height - self.height) / 2;
            width: 14px;
            height: 14px;
            value: root.value;
        }

        Text {
            text: root.value.alpha == 0 ? "None" : Styling.to-hex(root.value);
            font-size: 12px;
            overflow: elide;
            color: #fafafa;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A number typed in (fractions like 0.5 too), shown as `value`.
component NumberField inherits Rectangle {
    in property <float> value;
    // inputs outside (0, max] are ignored
    in property <float> max;
    in property <string> unit: "px";
    // a valid number was typed (not yet committed)
    callback edited(float);
    // Enter was pressed; focus can go back to the shortcuts
    callback accepted();
    callback focus-changed(bool);

    changed value => { root.sync(); }
    init => { root.sync(); }

    function sync() {
        if !input.has-focus { input.text = round(root.value * 100) / 100; }
    }

    height: 24px;
    border-radius: 5px;
    background: ta.has-hover || input.has-focus ? #ffffff14 : #ffffff0a;
    border-width: 1px;
    border-color: input.has-focus ? #3b82f6 : #ffffff0f;

    ta := TouchArea {
        mouse-cursor: text;
        clicked => { input.focus(); }
    }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 4px;

        input := TextInput {
            single-line: true;
            vertical-alignment: center;
            font-size: 12px;
            color: #fafafa;
            selection-background-color: #3b82f680;
            edited => {
                if self.text.is-float() {
                    let v = self.text.to-float();
                    if v > 0 && v <= root.max { root.edited(v); }
                }
            }
            accepted => { root.accepted(); }
            changed has-focus => {
                root.focus-changed(self.has-focus);
                if !self.has-focus {
                    root.sync(); // drop anything invalid
                    Styling.commit();
                }
            }
        }

        Text {
            text: root.unit;
            font-size: 12px;
            color: #71717a;
            vertical-alignment: center;
        }
    }
}

// Shows a value; clicking opens a popover to pick another.
component PickField inherits Rectangle {
    in property <string> text;
    // the value is drawn in this font (empty: the UI's)
    in property <string> font-family;
    in property <int> font-weight: 400;
    in property <bool> active;
    callback clicked();

    height: 24px;
    border-radius: 5px;
    background: root.active ? #ffffff1f : ta.has-hover ? #ffffff14 : #ffffff0a;
    border-width: 1px;
    border-color: root.active ? #3b82f6 : #ffffff0f;
    animate background { duration: 90ms; }

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 4px;

        Text {
            text: root.text;
            font-family: root.font-family;
            font-weight: root.font-weight;
            font-size: 12px;
            overflow: elide;
            color: #fafafa;
            vertical-alignment: center;
        }

        Text {
            horizontal-stretch: 0;
            text: "▾";
            font-size: 10px;
            color: #71717a;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

global Weights {
    public pure function name(w: int) -> string {
        w == 100 ? "Thin" : w == 200 ? "Extra Light" : w == 300 ? "Light"
            : w == 400 ? "Regular" : w == 500 ? "Medium" : w == 600 ? "Semibold"
            : w == 700 ? "Bold" : w == 800 ? "Extra Bold" : w == 900 ? "Black"
            : "\{w}"
    }
}

component Row inherits HorizontalLayout {
    in property <string> label;
    spacing: 4px;

    Text {
        width: 40px;
        text: root.label;
        font-size: 11px;
        color: #a1a1aa;
        vertical-alignment: center;
    }

    @children
}

// The style of new shapes, or of the selection: color fields that open
// a ColorPopover, the stroke width, the size of a selected box shape,
// and for text the font.
export component StylePanel inherits Rectangle {
    // the field whose popover is open, if `picking`
    in property <bool> picking;
    in property <StyleField> picking-field;
    callback open-picker(StyleField);
    // a number input is done; focus can go back to the shortcuts
    callback input-accepted();

    // only the drawing tools and a selection have a style to edit
    property <Action> tool: Actions.current-tool;
    out property <bool> relevant: Styling.has-selection
        || tool == Action.brush || tool == Action.text || tool == Action.rectangle
        || tool == Action.circle || tool == Action.arrow || tool == Action.blur
        || tool == Action.eyedropper;
    property <bool> show-color: Styling.has-selection ? Styling.selection-colored : tool != Action.blur;
    property <bool> show-fill: Styling.has-selection ? Styling.selection-fillable
        : tool == Action.rectangle || tool == Action.circle;
    property <bool> show-width: Styling.has-selection ? Styling.selection-stroked
        : tool != Action.text && tool != Action.blur && tool != Action.eyedropper;
    // "none" is allowed while the other one still shows the shape; a stroke
    // only on rectangles and circles, since nothing else has a fill
    out property <bool> fill-clearable: Styling.stroke.alpha > 0;
    out property <bool> stroke-clearable: Styling.fill.alpha > 0 && (Styling.has-selection
        ? Styling.selection-stroke-optional : tool == Action.rectangle || tool == Action.circle);
    // a new shape without a fill always gets a visible stroke
    changed tool => {
        if !Styling.has-selection && Styling.stroke.alpha == 0
            && tool != Action.rectangle && tool != Action.circle {
            Styling.stroke = Styling.stroke.with-alpha(1);
        }
    }
    property <bool> show-strength: Styling.has-selection ? Styling.selection-blur : tool == Action.blur;
    property <bool> show-font: Styling.has-selection ? Styling.selection-text : tool == Action.text;

    // a number input has focus
    property <bool> typing;
    // faded at rest (less than the toolbars: its values should stay readable); solid while in use
    property <bool> active: ta.has-hover || root.picking || root.typing;

    height: self.preferred-height;

    background: root.active ? #18181bb3 : #18181b75;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.active ? #ffffff14 : #ffffff0f;
    drop-shadow-blur: 12px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: root.active ? #00000040 : #00000030;
    opacity: root.active ? 1 : 0.75;
    animate background, border-color, drop-shadow-color, opacity { duration: 120ms; }

    // swallows clicks so they don't reach the canvas below, and tracks hover
    ta := TouchArea {
        VerticalLayout {
            padding: 4px;
            spacing: 3px;

            if root.show-color: Row {
                label: "Color";
                ColorField {
                    value: Styling.stroke;
                    active: root.picking && root.picking-field == StyleField.stroke;
                    clicked => { root.open-picker(StyleField.stroke); }
                }
            }

            if root.show-fill: Row {
                label: "Fill";
                ColorField {
                    value: Styling.fill;
                    active: root.picking && root.picking-field == StyleField.fill;
                    clicked => { root.open-picker(StyleField.fill); }
                }
            }

            if Styling.has-size: Row {
                label: "Width";
                NumberField {
                    value: Styling.width;
                    max: 100000;
                    edited(v) => {
                        Styling.width = v;
                        Styling.preview(StyleField.size);
                    }
                    accepted => { root.input-accepted(); }
                    focus-changed(f) => { root.typing = f; }
                }
            }

            if Styling.has-size: Row {
                label: "Height";
                NumberField {
                    value: Styling.height;
                    max: 100000;
                    edited(v) => {
                        Styling.height = v;
                        Styling.preview(StyleField.size);
                    }
                    accepted => { root.input-accepted(); }
                    focus-changed(f) => { root.typing = f; }
                }
            }

            if root.show-width: Row {
                label: "Stroke";
                NumberField {
                    value: Styling.radius * 2;
                    max: 200;
                    edited(w) => {
                        Styling.radius = w / 2;
                        Styling.preview(StyleField.radius);
                    }
                    accepted => { root.input-accepted(); }
                    focus-changed(f) => { root.typing = f; }
                }
            }

            if root.show-strength: Row {
                label: "Strength";
                NumberField {
                    value: Styling.blur;
                    max: 100;
                    edited(v) => {
                        Styling.blur = v;
                        Styling.preview(StyleField.blur);
                    }
                    accepted => { root.input-accepted(); }
                    focus-changed(f) => { root.typing = f; }
                }
            }

            if root.show-font: Row {
                label: "Font";
                PickField {
                    text: Styling.font-family;
                    font-family: Styling.font-family;
                    active: root.picking && root.picking-field == StyleField.font-family;
                    clicked => { root.open-picker(StyleField.font-family); }
                }
            }

            if root.show-font: Row {
                label: "Weight";
                PickField {
                    text: Weights.name(Styling.font-weight);
                    font-family: Styling.font-family;
                    font-weight: Styling.font-weight;
                    active: root.picking && root.picking-field == StyleField.font-weight;
                    clicked => { root.open-picker(StyleField.font-weight); }
                }
            }

            if root.show-font: Row {
                label: "Size";
                NumberField {
                    value: Styling.font-size;
                    max: 1000;
                    edited(v) => {
                        Styling.font-size = v;
                        Styling.preview(StyleField.font-size);
                    }
                    accepted => { root.input-accepted(); }
                    focus-changed(f) => { root.typing = f; }
                }
            }
        }
    }
}

component Swatch inherits Rectangle {
    in property <color> value;
    in property <bool> active;
    callback clicked();

    width: 24px;
    height: 24px;
    border-radius: 5px;
    background: root.active ? #ffffff1f : ta.has-hover ? #ffffff12 : transparent;

    ColorDot {
        width: 16px;
        height: 16px;
        value: root.value;
    }

    if root.active: Rectangle {
        width: 20px;
        height: 20px;
        border-radius: 10px;
        border-width: 1.5px;
        border-color: #fafafa;
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A small square icon button for the popovers; `active` shows it as on.
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked();

    width: 22px;
    height: 22px;
    border-radius: 5px;
    background: root.active ? #3b82f6 : ta.has-hover ? #ffffff14 : transparent;
    opacity: root.enabled ? 1 : 0.35;
    animate background { duration: 90ms; }

    Image {
        width: 14px;
        height: 14px;
        source: root.icon;
        colorize: root.active || ta.has-hover ? #ffffff : #a1a1aa;
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// Color picker for one Styling field, plus the colors already used.
export component ColorPopover inherits FocusScope {
    in property <StyleField> field;
    // the field may be set to none (the shape stays visible without it)
    in property <bool> clearable;
    // the eyedropper button is on (the window does the picking)
    in property <bool> sampling;
    callback close();
    callback toggle-sampling();
    // the header was dragged by this much
    callback dragged(length, length);

    public function open-with(c: color) {
        // "none" opens opaque, so picking a color doesn't land on 0 alpha
        picker.set-color(c.alpha == 0 ? c.with-alpha(1) : c);
        root.focus();
    }

    // a color picked from the image (live; the window commits on release)
    public function take(c: color) {
        picker.set-color(c);
        root.set(c);
    }

    function set(c: color) {
        if root.field == StyleField.fill { Styling.fill = c; } else { Styling.stroke = c; }
        Styling.preview(root.field);
    }

    property <color> current: root.field == StyleField.fill ? Styling.fill : Styling.stroke;

    // none; the picker stays opaque so the next edit gives a visible color
    function clear() {
        if !root.clearable { return; }
        root.set(transparent);
        Styling.commit();
        picker.set-color(picker.value.with-alpha(1));
    }

    // the fill picker's first swatch is "none"
    property <int> lead: root.field == StyleField.fill ? 1 : 0;
    property <int> count: Styling.used-colors.length + root.lead;
    property <length> pad: 10px;
    property <length> cell: 25px; // swatch + 1px gap
    property <int> cols: 6;

    width: root.cols * root.cell - 1px + 2 * root.pad;
    height: panel.preferred-height;

    // the hex/RGBA inputs take their own keys, so "i" there is just typed
    key-pressed(e) => {
        if e.text == Key.Escape {
            root.close();
            return accept;
        }
        if e.text == "i" && !e.modifiers.control {
            root.toggle-sampling();
            return accept;
        }
        reject
    }

    panel := Rectangle {
        background: #18181bf2;
        border-radius: 8px;
        border-width: 1px;
        border-color: #ffffff14;
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #00000070;

        TouchArea { }

        VerticalLayout {
            padding: root.pad;
            spacing: 10px;

            // the header moves the popover
            Rectangle {
                height: 22px;

                TouchArea {
                    mouse-cursor: move;
                    moved => { root.dragged(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y); }
                }

                HorizontalLayout {
                    Text {
                        text: root.field == StyleField.fill ? "Fill" : "Stroke";
                        font-size: 12px;
                        color: #fafafa;
                        vertical-alignment: center;
                    }

                    IconButton {
                        icon: @image-url("../assets/icons/ban.svg");
                        active: root.current.alpha == 0;
                        enabled: root.clearable || self.active;
                        clicked => { root.clear(); }
                    }

                    IconButton {
                        icon: @image-url("../assets/icons/cancel.svg");
                        clicked => { root.close(); }
                    }
                }
            }

            picker := ColorPicker {
                edited(c) => { root.set(c); }
                committed => { Styling.commit(); }
            }

            Rectangle {
                height: 1px;
                background: #ffffff14;
            }

            HorizontalLayout {
                Text {
                    text: "Used in image";
                    font-size: 11px;
                    color: #a1a1aa;
                    vertical-alignment: center;
                }

                // pick a color from the image
                IconButton {
                    icon: @image-url("../assets/icons/eyedropper.svg");
                    active: root.sampling;
                    clicked => { root.toggle-sampling(); }
                }
            }

            if root.count == 0: Text {
                text: "Nothing drawn yet";
                font-size: 11px;
                color: #71717a;
            }

            if root.count > 0: Rectangle {
                height: ceil(root.count / root.cols) * root.cell - 1px;

                if root.lead == 1: Swatch {
                    x: 0;
                    y: 0;
                    value: transparent;
                    active: Styling.fill.alpha == 0;
                    clicked => { root.clear(); }
                    opacity: root.clearable || self.active ? 1 : 0.35;
                }

                for c[i] in Styling.used-colors: Swatch {
                    property <int> j: i + root.lead;
                    x: mod(self.j, root.cols) * root.cell;
                    y: floor(self.j / root.cols) * root.cell;
                    value: c;
                    active: picker.value == c;
                    clicked => {
                        picker.set-color(c);
                        root.set(c);
                        Styling.commit();
                    }
                }
            }
        }
    }
}

// Searchable list of the installed font families, each shown in itself.
export component FontPopover inherits FocusScope {
    callback close();

    public function open() {
        search.text = "";
        list.content-y = 0;
        search.focus();
    }

    function pick(f: string) {
        Styling.font-family = f;
        Styling.preview(StyleField.font-family);
        root.close();
    }

    property <[string]> matches: Styling.find-fonts(search.text);

    width: 240px;
    height: 320px;

    key-pressed(e) => {
        if e.text == Key.Escape {
            root.close();
            return accept;
        }
        reject
    }

    Rectangle {
        background: #18181bf2;
        border-radius: 8px;
        border-width: 1px;
        border-color: #ffffff14;
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #00000070;

        TouchArea { }

        VerticalLayout {
            padding: 8px;
            spacing: 6px;

            Rectangle {
                height: 26px;
                border-radius: 5px;
                background: #ffffff0a;
                border-width: 1px;
                border-color: search.has-focus ? #3b82f6 : #ffffff0f;

                if search.text == "": Text {
                    x: 7px;
                    text: "Search fonts";
                    font-size: 12px;
                    color: #71717a;
                    vertical-alignment: center;
                }

                search := TextInput {
                    x: 7px;
                    width: parent.width - 14px;
                    single-line: true;
                    vertical-alignment: center;
                    font-size: 12px;
                    color: #fafafa;
                    selection-background-color: #3b82f680;
                    // Enter takes the first match
                    accepted => {
                        if root.matches.length > 0 { root.pick(root.matches[0]); }
                    }
                }
            }

            if root.matches.length == 0: Text {
                text: "No fonts match";
                font-size: 11px;
                color: #71717a;
            }

            list := ListView {
                for f in root.matches: Rectangle {
                    height: 26px;
                    border-radius: 4px;
                    background: f == Styling.font-family ? #3b82f640 : ta.has-hover ? #ffffff14 : transparent;

                    Text {
                        x: 6px;
                        width: parent.width - 12px;
                        text: f;
                        font-family: f;
                        font-size: 14px;
                        color: #fafafa;
                        overflow: elide;
                        vertical-alignment: center;
                    }

                    ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.pick(f); }
                    }
                }
            }
        }
    }
}

// The weights the current family has, each shown in itself.
export component WeightPopover inherits FocusScope {
    callback close();

    public function open() {
        root.focus();
    }

    width: 180px;
    height: panel.preferred-height;

    key-pressed(e) => {
        if e.text == Key.Escape {
            root.close();
            return accept;
        }
        reject
    }

    panel := Rectangle {
        background: #18181bf2;
        border-radius: 8px;
        border-width: 1px;
        border-color: #ffffff14;
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: #00000070;

        TouchArea { }

        VerticalLayout {
            padding: 6px;
            spacing: 1px;

            for w in Styling.font-weights: Rectangle {
                height: 26px;
                border-radius: 4px;
                background: w == Styling.font-weight ? #3b82f640 : ta.has-hover ? #ffffff14 : transparent;

                Text {
                    x: 6px;
                    width: parent.width - 12px;
                    text: Weights.name(w);
                    font-family: Styling.font-family;
                    font-weight: w;
                    font-size: 14px;
                    color: #fafafa;
                    overflow: elide;
                    vertical-alignment: center;
                }

                ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        Styling.font-weight = w;
                        Styling.preview(StyleField.font-weight);
                        root.close();
                    }
                }
            }
        }
    }
}

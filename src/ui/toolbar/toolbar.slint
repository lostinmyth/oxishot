import { Action, Actions } from "../actions.slint";

import { Settings } from "../settings.slint";

import { ToolbarButton } from "toolbar_button.slint";

// the tooltip shows `name` and the action's shortcut
export struct ToolDef { icon: image, name: string, action: Action }

export component Toolbar inherits Rectangle {
    in property <bool> selectable: true;
    in property <[ToolDef]> tools;
    // tooltips open above the bar (for bars along the bottom edge) instead of below
    in property <bool> tips-above;
    // width of the area tooltips must stay inside (the window)
    in property <length> view-width;

    // index of the hovered button, -1 for none
    property <int> hover-index: -1;
    // set once the pointer has rested on a button; stays set while it slides
    // across the bar, so neighbouring tooltips show without a fresh delay
    property <bool> tip-shown;

    // must match the HorizontalLayout below
    property <length> pad: 3px;
    property <length> button-size: 30px;
    property <length> gap: 1px;

    // faint panel at rest, a bit stronger on hover
    background: ta.has-hover ? #18181bb3 : #18181b38;
    border-radius: 8px;
    border-width: 1px;
    border-color: ta.has-hover ? #ffffff14 : #ffffff0a;
    drop-shadow-blur: 12px;
    drop-shadow-offset-y: 2px;
    drop-shadow-color: ta.has-hover ? #00000040 : #00000020;
    animate background, border-color, drop-shadow-color { duration: 120ms; }

    width: self.preferred-width;
    height: self.preferred-height;

    Timer {
        interval: 150ms;
        running: root.hover-index >= 0 && !root.tip-shown;
        triggered => { root.tip-shown = true; }
    }

    ta := TouchArea {
        changed has-hover => {
            if !self.has-hover { root.tip-shown = false; }
        }

        HorizontalLayout {
            padding: root.pad;
            spacing: root.gap;
            for tool[i] in root.tools: ToolbarButton {
                icon: tool.icon;
                active: selectable && tool.action == Actions.current-tool;
                changed hovered => {
                    if self.hovered {
                        root.hover-index = i;
                    } else if root.hover-index == i {
                        root.hover-index = -1;
                    }
                }
                clicked => {
                    if selectable {
                        Actions.current-tool = tool.action;
                    }
                    Actions.dispatch(tool.action)
                }
            }
        }
    }

    if root.tip-shown && root.hover-index >= 0: tip := Rectangle {
        property <ToolDef> tool: root.tools[root.hover-index];
        property <string> shortcut: Settings.label(self.tool.action, Settings.version);
        property <length> button-center: root.pad + root.hover-index * (root.button-size + root.gap) + root.button-size / 2;
        // centered on the button, but kept 4px inside the window
        property <length> min-x: 4px - root.absolute-position.x;
        property <length> max-x: root.view-width - 4px - self.width - root.absolute-position.x;

        x: max(min-x, min(max-x, self.button-center - self.width / 2));
        y: root.tips-above ? -self.height - 6px : root.height + 6px;
        width: self.preferred-width;
        height: self.preferred-height;

        background: #18181bf2;
        border-radius: 5px;
        border-width: 1px;
        border-color: #ffffff14;
        drop-shadow-blur: 8px;
        drop-shadow-offset-y: 2px;
        drop-shadow-color: #00000060;

        HorizontalLayout {
            padding-left: 8px;
            padding-right: 8px;
            padding-top: 4px;
            padding-bottom: 4px;
            spacing: 8px;

            Text {
                text: tip.tool.name;
                color: #fafafa;
                font-size: 12px;
                vertical-alignment: center;
            }

            if tip.shortcut != "": Text {
                text: tip.shortcut;
                color: #a1a1aa;
                font-size: 12px;
                vertical-alignment: center;
            }
        }
    }
}

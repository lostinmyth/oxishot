// `angle` (degrees) turns the box about its center
export struct SelectionBox { x: float, y: float, width: float, height: float, angle: float }
export struct Vec2 { x: float, y: float }
// how a select-tool press combines with the current selection (shift adds, ctrl removes)
export enum SelectionMode { replace, add, remove }

export global Canvas {
    callback begin(float, float);
    callback extend(float, float);
    callback end(float, float);
    callback select-begin(float, float, SelectionMode);
    // drawing tools: a press that grabs the selection instead of drawing;
    // returns whether it did (otherwise the selection is dropped)
    callback grab(float, float) -> bool;
    callback commit-text(float, float, string);
    // the pointer moved without a button held (while something can be selected)
    callback hover(float, float);

    in property <string> live-path;
    in property <image> overlay;

    // select tool: the lifted shape is drawn alone in drag-overlay and
    // shifted by drag-offset (or turned by drag-angle about drag-pivot),
    // so moving and rotating never re-rasterize anything; scaling redraws
    // drag-overlay itself
    in property <image> drag-overlay;
    in property <bool> dragging;
    in property <bool> rotating;
    in property <bool> scaling;
    in property <Vec2> drag-offset;
    in property <Vec2> drag-pivot;
    in property <angle> drag-angle;
    // the pointer is just outside a selected shape's corner, where a press rotates
    in property <bool> rotate-hover;
    // which way the hovered corner faces (degrees, 0 = top-left), for the rotate icon
    in property <float> rotate-cursor;
    // the pointer is on a selected shape's corner handle, where a press scales
    in property <bool> scale-hover;
    // which way that corner faces (degrees, 0 = top-left), for the scale icon;
    // kept while scaling, which never turns the boxes
    in property <float> scale-cursor;
    in property <[SelectionBox]> selection;
    in property <bool> has-marquee;
    in property <SelectionBox> marquee;
    in property <float> font-size: 24;
}
